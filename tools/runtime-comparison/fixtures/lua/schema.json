{
  "version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["recognition", "priorities", "actions", "postcondition"],
  "properties": {
    "recognition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["threshold", "roi", "asset"],
      "default": {"threshold": 0.9, "roi": {"x": 0, "y": 0, "width": 640, "height": 480}, "asset": "marker"},
      "properties": {
        "threshold": {"type": "number", "minimum": 0, "maximum": 1},
        "asset": {"type": "string", "minLength": 1, "maxLength": 64},
        "expected": {"type": "string", "minLength": 1, "maxLength": 64},
        "roi": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "width", "height"],
          "properties": {
            "x": {"type": "integer", "minimum": 0, "maximum": 639},
            "y": {"type": "integer", "minimum": 0, "maximum": 479},
            "width": {"type": "integer", "minimum": 1, "maximum": 640},
            "height": {"type": "integer", "minimum": 1, "maximum": 480}
          }
        }
      }
    },
    "priorities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {"type": "string", "enum": ["template", "ocr"]},
      "default": ["template", "ocr"]
    },
    "actions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["template", "ocr"],
      "properties": {
        "template": {
          "type": "array", "minItems": 1, "maxItems": 32,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["kind"],
            "properties": {
              "kind": {"type": "string", "enum": ["key_down", "key_up", "click"]},
              "key": {"type": "string", "minLength": 1, "maxLength": 32},
              "x": {"type": "number", "minimum": 0, "maximum": 640},
              "y": {"type": "number", "minimum": 0, "maximum": 480},
              "button": {"type": "string", "enum": ["left", "right", "middle"]}
            }
          }
        },
        "ocr": {
          "type": "array", "minItems": 1, "maxItems": 32,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["kind"],
            "properties": {
              "kind": {"type": "string", "enum": ["key_down", "key_up", "click"]},
              "key": {"type": "string", "minLength": 1, "maxLength": 32},
              "x": {"type": "number", "minimum": 0, "maximum": 640},
              "y": {"type": "number", "minimum": 0, "maximum": 480},
              "button": {"type": "string", "enum": ["left", "right", "middle"]}
            }
          }
        }
      },
      "default": {
        "template": [{"kind": "key_down", "key": "A"}, {"kind": "key_up", "key": "A"}],
        "ocr": [{"kind": "key_down", "key": "B"}, {"kind": "key_up", "key": "B"}]
      }
    },
    "postcondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected", "roi", "wait_ms"],
      "default": {"expected": "DONE", "roi": {"x": 100, "y": 80, "width": 40, "height": 20}, "wait_ms": 0},
      "properties": {
        "expected": {"type": "string", "minLength": 1, "maxLength": 64},
        "wait_ms": {"type": "integer", "minimum": 0, "maximum": 1000},
        "roi": {
          "type": "object", "additionalProperties": false,
          "required": ["x", "y", "width", "height"],
          "properties": {
            "x": {"type": "integer", "minimum": 0, "maximum": 639},
            "y": {"type": "integer", "minimum": 0, "maximum": 479},
            "width": {"type": "integer", "minimum": 1, "maximum": 640},
            "height": {"type": "integer", "minimum": 1, "maximum": 480}
          }
        }
      }
    }
  }
}
