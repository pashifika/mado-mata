{
  "version": 1,
  "type": "object",
  "additionalProperties": false,
  "required": ["recognition", "priorities", "actions", "postcondition"],
  "properties": {
    "recognition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["threshold", "roi"],
      "default": {"threshold": 0.9, "roi": {"x": 0, "y": 0, "width": 640, "height": 480}},
      "properties": {
        "threshold": {"type": "number", "minimum": 0, "maximum": 1},
        "roi": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "width", "height"],
          "properties": {
            "x": {"type": "integer", "minimum": 0, "maximum": 639},
            "y": {"type": "integer", "minimum": 0, "maximum": 479},
            "width": {"type": "integer", "minimum": 1, "maximum": 640},
            "height": {"type": "integer", "minimum": 1, "maximum": 480}
          }
        }
      }
    },
    "priorities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {"type": "string", "enum": ["template", "ocr"]},
      "default": ["template", "ocr"]
    },
    "actions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["template", "ocr"],
      "properties": {
        "template": {"type": "string", "minLength": 1, "maxLength": 1},
        "ocr": {"type": "string", "minLength": 1, "maxLength": 1}
      },
      "default": {"template": "A", "ocr": "B"}
    },
    "postcondition": {"type": "string", "enum": ["DONE"], "default": "DONE"}
  }
}
